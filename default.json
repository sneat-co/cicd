{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "timezone": "Europe/Dublin",
  "schedule": [
    "* 0-3 * * 1"
  ],
  "packageRules": [
    {
      "description": "Batch GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Batch JavaScript dependencies managed through npm, pnpm, or Yarn",
      "matchManagers": [
        "npm"
      ],
      "groupName": "JavaScript dependencies",
      "groupSlug": "javascript-dependencies"
    },
    {
      "description": "Batch dependencies published from the Sneat-Co GitHub organization",
      "matchSourceUrls": [
        "https://github.com/sneat-co/**"
      ],
      "groupName": "sneat-co dependencies",
      "groupSlug": "sneat-co-dependencies"
    }
  ]
}
